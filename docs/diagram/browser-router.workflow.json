{
  "schema_version": 2,
  "diagram_type": "workflow",
  "meta": {
    "title": "Where a link goes",
    "locale": "en",
    "quality_profile": "showcase",
    "legend": {
      "mode": "auto",
      "entries": {
        "external": {
          "label": "You click a link"
        },
        "backend": {
          "label": "Browser Router"
        },
        "frontend": {
          "label": "Browsers"
        }
      }
    },
    "viewBox": [
      1180,
      404
    ]
  },
  "lanes": [
    {
      "id": "unmatched",
      "label": "With no rules at all"
    },
    {
      "id": "matched",
      "label": "With one rule"
    }
  ],
  "mainPath": [
    "whatsapp",
    "router_b",
    "firefox"
  ],
  "nodes": [
    {
      "id": "whatsapp",
      "lane": "unmatched",
      "col": 0,
      "type": "external",
      "label": "WhatsApp",
      "sublabel": "you click a link",
      "width": 150
    },
    {
      "id": "router_b",
      "lane": "unmatched",
      "col": 1,
      "type": "backend",
      "label": "Browser Router",
      "sublabel": "your default browser",
      "width": 160
    },
    {
      "id": "firefox",
      "lane": "unmatched",
      "col": 2,
      "type": "frontend",
      "label": "Firefox",
      "sublabel": "ticked in the menubar",
      "width": 150
    },
    {
      "id": "mail",
      "lane": "matched",
      "col": 0,
      "type": "external",
      "label": "Mail",
      "sublabel": "you click a link",
      "width": 150
    },
    {
      "id": "router_a",
      "lane": "matched",
      "col": 1,
      "type": "backend",
      "label": "Browser Router",
      "sublabel": "your default browser",
      "width": 160
    },
    {
      "id": "chromework",
      "lane": "matched",
      "col": 2,
      "type": "frontend",
      "label": "Chrome — Work",
      "sublabel": "opens here",
      "width": 150
    }
  ],
  "edges": [
    {
      "id": "mail-router",
      "from": "mail",
      "to": "router_a",
      "variant": "default"
    },
    {
      "id": "router-work",
      "from": "router_a",
      "to": "chromework",
      "label": "rule: Mail → chrome work",
      "variant": "default"
    },
    {
      "id": "whatsapp-router",
      "from": "whatsapp",
      "to": "router_b",
      "variant": "emphasis"
    },
    {
      "id": "router-firefox",
      "from": "router_b",
      "to": "firefox",
      "label": "no rule matched",
      "variant": "emphasis"
    }
  ],
  "cards": [
    {
      "dot": "cyan",
      "title": "Without rules",
      "items": [
        "Every link opens in the browser ticked in the menubar",
        "Tick a different one and every link follows"
      ]
    },
    {
      "dot": "rose",
      "title": "With one rule",
      "items": [
        "Mail -> chrome work sends mail links to the work profile",
        "Everything else keeps going to the ticked browser"
      ]
    }
  ]
}